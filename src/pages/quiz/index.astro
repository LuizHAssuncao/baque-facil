---
import LanguageHead from "../../components/LanguageHead.astro";
import LanguagePicker from "../../components/LanguagePicker.astro";
import T from "../../components/TranslatedText.astro";
import { translatedAttributes } from "../../lib/i18n/messages";
import { ArrowLeft } from "lucide-react";
import Disclaimer from "../../components/Disclaimer.astro";
import PwaHead from "../../components/PwaHead.astro";
import RhythmQuiz from "../../components/RhythmQuiz";
import "../../styles/global.css";
---

<!doctype html>
<html lang="en-CA">
  <head>
    <PwaHead />
    <meta charset="UTF-8" />
    <LanguageHead />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" {...translatedAttributes({ "content": "Get to know Maracatu rhythms by ear. Read a rhythm name, listen, and find its sound." })} />
    <title data-i18n-text={JSON.stringify("Quiz | Baque Fácil")}>{"Quiz | Baque Fácil"}</title>
  </head>
  <body>
    <main class="page-shell quiz-page">
      <LanguagePicker />
      <a class="back-link" href="/">
        <ArrowLeft aria-hidden="true" size={18} />
        <T message="All rhythms" />
      </a>
      <header class="page-header quiz-header">
        <p class="eyebrow"><T message="Listening practice" /></p>
        <h1><T message="Quiz" /></h1>
        <p><T message="Read the name, listen to the options, and find the matching rhythm." /></p>
      </header>
      <RhythmQuiz client:load />
      <noscript><p><T message="Enable JavaScript to listen to the options and practice." /></p></noscript>
      <Disclaimer />
    </main>
  </body>
</html>
