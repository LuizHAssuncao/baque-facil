---
import LanguageHead from "../components/LanguageHead.astro";
import LanguagePicker from "../components/LanguagePicker.astro";
import T from "../components/TranslatedText.astro";
import { translatedAttributes, type Message } from "../lib/i18n/messages";
import { getCollection } from "astro:content";
import { ChevronRight, Headphones, PencilLine, Radio } from "lucide-react";
import LanguageChoices from "../components/LanguageChoices.astro";
import Disclaimer from "../components/Disclaimer.astro";
import PwaHead from "../components/PwaHead.astro";
import OfflineRefresh from "../components/OfflineRefresh.astro";
import "../styles/global.css";

const rhythms = (await getCollection("rhythms")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
const isCombo = (rhythm: (typeof rhythms)[number]) =>
  rhythm.slug.startsWith("combo") || rhythm.data.title.toLowerCase().startsWith("combo");
const comboRhythms = rhythms.filter(isCombo);
const practiceRhythms = rhythms.filter((rhythm) => !isCombo(rhythm));
const homeTools = [
  {
    id: "radio",
    heading: "Radio",
    title: "Listen to Baque Radio",
    description: "Play along with a mix of Maracatu rhythms.",
    href: "/radio/",
    icon: Radio,
  },
  {
    id: "listening",
    heading: "Listening practice",
    title: "Rhythm Quiz",
    description: "Listen and find the matching rhythm.",
    href: "/quiz/",
    icon: Headphones,
  },
  {
    id: "composer",
    heading: "Composer",
    title: "Compose an Alfaia rhythm",
    description: "Record an Alfaia rhythm on a beat-based grid",
    href: "/compose/",
    icon: PencilLine,
  },
] as const;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <PwaHead />
    <meta charset="UTF-8" />
    <LanguageHead />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Baque Fácil</title>
  </head>
  <body>
    <main class="page-shell">
      <LanguagePicker />
      <header class="page-header home-hero">
        <div class="home-hero-copy">
          <p class="eyebrow"><T message="Maracatu rhythm studio" /></p>
          <h1>Baque Fácil</h1>
          <p><T message="Learn, listen and compose alfaia patterns." /></p>
        </div>
        <div class="home-hero-media" aria-hidden="true">
          <img
            class="home-hero-image"
            src="/alfaia-editorial-hero.png"
            alt=""
            width="1536"
            height="1024"
            decoding="async"
          />
        </div>
      </header>

      <section class="home-section" aria-labelledby="rhythms-heading">
        <h2 id="rhythms-heading"><T message="Rhythms" /></h2>
        <div class="rhythm-list">
          {
            practiceRhythms.map((rhythm) => (
              <a class="rhythm-link" href={`/rhythms/${rhythm.slug}/`}>
                <strong>{rhythm.data.title}</strong>
                <span><T message={rhythm.data.difficulty as Message} /></span>
              </a>
            ))
          }
        </div>
      </section>

      <section class="home-section" aria-labelledby="combos-heading">
        <h2 id="combos-heading"><T message="Combos" /></h2>
        <div class="rhythm-list">
          {
            comboRhythms.map((rhythm) => (
              <a class="rhythm-link" href={`/rhythms/${rhythm.slug}/`}>
                <strong>{rhythm.data.title}</strong>
                <span><T message={rhythm.data.difficulty as Message} /></span>
              </a>
            ))
          }
        </div>
      </section>

      <div class="home-tools">
        {
          homeTools.map(({ id, heading, title, description, href, icon: Icon }) => (
            <section class="home-section" aria-labelledby={`${id}-heading`}>
              <h2 id={`${id}-heading`}><T message={heading} /></h2>
              <a
                class="home-tool-card"
                href={href}
                aria-labelledby={`${id}-title`}
                aria-describedby={`${id}-description`}
              >
                <span class="home-tool-icon" aria-hidden="true">
                  <Icon size={22} />
                </span>
                <span class="home-tool-copy">
                  <strong id={`${id}-title`}><T message={title} /></strong>
                  <span class="home-tool-description" id={`${id}-description`}>
                    <T message={description} />
                  </span>
                </span>
                <ChevronRight className="home-tool-arrow" size={20} aria-hidden="true" />
              </a>
            </section>
          ))
        }
      </div>

      <details class="preference-disclosure" id="settings">
        <summary><T message="Settings" /></summary>
        <div class="language-settings" role="group" {...translatedAttributes({ "aria-label": "Language" })}>
          <strong><T message="Language" /></strong>
          <LanguageChoices />
        </div>
        <label class="hand-preference-toggle">
          <input id="left-handed-mode" type="checkbox" />
          <span>
            <strong><T message="Left-handed mode" /></strong>
            <small><T message="Reverse R (right) and L (left) in rhythm grids." /></small>
          </span>
        </label>
        <OfflineRefresh />
      </details>

      <Disclaimer />
    </main>

    <script>
      import {
        readHandSymbolReversePreference,
        writeHandSymbolReversePreference,
      } from "../lib/handPreference";

      const leftHandedMode = document.querySelector<HTMLInputElement>("#left-handed-mode");

      if (leftHandedMode) {
        leftHandedMode.checked = readHandSymbolReversePreference();
        leftHandedMode.addEventListener("change", () => {
          writeHandSymbolReversePreference(leftHandedMode.checked);
        });
      }
    </script>
  </body>
</html>
