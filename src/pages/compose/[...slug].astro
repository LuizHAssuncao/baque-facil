---
import LanguageHead from "../../components/LanguageHead.astro";
import LanguagePicker from "../../components/LanguagePicker.astro";
import T from "../../components/TranslatedText.astro";
import { translatedAttributes, errorMessage, type Message } from "../../lib/i18n/messages";
import { getCollection } from "astro:content";
import { ArrowLeft } from "lucide-react";
import Disclaimer from "../../components/Disclaimer.astro";
import RhythmComposer from "../../components/RhythmComposer";
import { extractRhythmBlock } from "../../lib/extractRhythmBlock";
import { parseRhythm } from "../../lib/parseRhythm";
import { validateRhythmIssues } from "../../lib/validateRhythm";
import type { Rhythm } from "../../lib/rhythmTypes";
import "../../styles/global.css";

export async function getStaticPaths() {
  const rhythms = await getCollection("rhythms");

  return [
    { params: { slug: undefined }, props: { entry: null } },
    ...rhythms.map((entry) => ({
      params: { slug: entry.slug },
      props: { entry },
    })),
  ];
}

const { entry } = Astro.props;
let initialRhythm: Rhythm | undefined;
let initialTranscription: string | undefined;
let errors: Message[] = [];

if (entry) {
  const rhythmBlock = extractRhythmBlock(entry.body);

  if (!rhythmBlock) {
    errors = ["Rhythm block not found."];
  } else {
    try {
      initialRhythm = {
        title: entry.data.title,
        slug: entry.slug,
        tempo: entry.data.tempo,
        subdivision: entry.data.subdivision,
        tracks: parseRhythm(rhythmBlock),
      };
      errors = validateRhythmIssues(initialRhythm);
      initialTranscription = [
        "---",
        `title: ${JSON.stringify(entry.data.title)}`,
        `tempo: ${entry.data.tempo}`,
        `subdivision: ${entry.data.subdivision}`,
        `difficulty: ${JSON.stringify(entry.data.difficulty)}`,
        "instruments:",
        ...entry.data.instruments.map((instrument) => `  - ${JSON.stringify(instrument)}`),
        "---",
        "",
        entry.body.trim(),
        "",
      ].join("\n");
    } catch (cause) {
      errors = [errorMessage(cause, "Unable to load rhythm.")];
    }
  }
}
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <LanguageHead />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/samples/alfaia/left-ghost.wav" as="audio" type="audio/wav" />
    <link rel="preload" href="/samples/alfaia/right-accent.wav" as="audio" type="audio/wav" />
    <title data-i18n-text={JSON.stringify(entry ? { key: "Customize {title} | Baque Fácil", values: { title: entry.data.title } } : "Compose | Baque Fácil")}>{entry ? `Customize ${entry.data.title}` : "Compose"} | Baque Fácil</title>
  </head>
  <body>
    <main class="page-shell">
      <LanguagePicker />
      <a class="back-link" href="/">
        <ArrowLeft aria-hidden="true" size={18} />
        <T message="All rhythms" />
      </a>

      <header class="page-header compact editorial-header">
        <p class="eyebrow"><T message="Composer" /></p>
        <h1><T message="Alfaia Composer" /></h1>
        {
          entry ? (
            <p><T message="Customize {title} in your own copy and export the transcription." values={{ title: entry.data.title }} /></p>
          ) : (
            <p><T message="Record an Alfaia rhythm on a beat-based grid and export the transcription." /></p>
          )
        }
      </header>

      {
        errors.length > 0 ? (
          <section class="error-panel" {...translatedAttributes({ "aria-label": "Rhythm validation errors" })}>
            <h2><T message="Rhythm errors" /></h2>
            <ul>
              {errors.map((error) => <li><T message={error} /></li>)}
            </ul>
          </section>
        ) : (
          <RhythmComposer
            client:load
            initialRhythm={initialRhythm}
            initialTranscription={initialTranscription}
          />
        )
      }
      <Disclaimer />
    </main>
  </body>
</html>
